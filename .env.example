# ── LLM (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Web Search ────────────────────────────────────────────────────────────────
# Get a free key at https://tavily.com  (no credit card required)
# If not set, the swarm falls back to DuckDuckGo (no key needed)
TAVILY_API_KEY=tvly-...

# ── NATS ─────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=artifex-queue

# ── Vector DB (Qdrant) ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=artifex

# ── Redis (optional – idempotency store) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=artifex

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=artifex123
DATABASE_URL=postgresql://artifex:artifex123@localhost:5432/placements

# ── Multi-model consortium ────────────────────────────────────────────────────
CONSORTIUM_MODELS=llama-3.1-8b-instant:2,gemma2-9b-it:2
ARBITER_MODEL=gemma2-9b-it
CONFIDENCE_THRESHOLD=0.7
CONSORTIUM_ALERT_THRESHOLD=0.7

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Kubernetes (Supervisor) ───────────────────────────────────────────────────
K8S_NAMESPACE=artifex
IN_CLUSTER=false

# ── Emergent swarm auction ────────────────────────────────────────────────────
# How long SwarmManager waits for agent bids before closing the auction
AUCTION_WINDOW_SECONDS=2
# How long SwarmManager waits for team members to confirm before assuming formed
TEAM_FORMATION_TIMEOUT_SECONDS=2
