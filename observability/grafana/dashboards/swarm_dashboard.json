{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Artifex Agent Swarm – operational dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Messages Processed / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(artifex_messages_processed_total[1m])) by (agent)",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(artifex_messages_failed_total[1m])) by (agent)",
          "legendFormat": "{{agent}} errors"
        }
      ]
    },
    {
      "id": 3,
      "title": "Processing Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(artifex_processing_seconds_bucket[5m])) by (le, agent))",
          "legendFormat": "{{agent}} p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Agent Heartbeat Age (seconds since last)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "time() - artifex_last_heartbeat_timestamp",
          "legendFormat": "{{agent}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 60 },
            { "color": "red", "value": 120 }
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(artifex_api_requests_total[1m])) by (endpoint, status)",
          "legendFormat": "{{endpoint}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "API Latency (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(artifex_api_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}} p99"
        }
      ]
    },
    {
      "id": 7,
      "title": "Foster – High-Risk Alerts Fired",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(increase(artifex_messages_processed_total{subject=\"foster.alerts\"}[24h]))",
          "legendFormat": "Alerts (24 h)"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Foster – Alerts Suppressed by Consortium",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "targets": [
        {
          "expr": "sum(increase(artifex_messages_failed_total{subject=\"foster.alerts\"}[24h]))",
          "legendFormat": "Suppressed (24 h)"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 3 }
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Foster – Placement Events / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(artifex_messages_processed_total{subject=~\"foster\\\\..*\"}[1m])) by (subject)",
          "legendFormat": "{{subject}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Foster – Check-in Processing Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(artifex_processing_seconds_bucket{agent=\"foster-monitor\"}[5m])) by (le))",
          "legendFormat": "foster-monitor p95"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["artifex", "agents", "swarm"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "Artifex Swarm Dashboard",
  "uid": "artifex-swarm-v1",
  "version": 1
}
